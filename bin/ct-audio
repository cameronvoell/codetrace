#!/usr/bin/env bash
# ct-audio start|stop|status — mic capture for the active session.
# Records 16kHz mono, which is what whisper wants natively (no resample step).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/ct-lib.sh"

src="${CT_AUDIO_SOURCE:-$(pactl get-default-source 2>/dev/null || echo default)}"

case "${1:-status}" in
devices)
  echo "input sources (monitors are desktop audio, not microphones):"
  echo
  pactl list sources 2>/dev/null | awk -v def="$src" '
    /^Source #/         {name="";desc="";mute="";vol=""}
    /^\tName:/          {name=$2}
    /^\tDescription:/   {sub(/^\tDescription: /,"");desc=$0}
    /^\tMute:/          {mute=$2}
    /^\tVolume:/ {match($0,/[0-9]+%/); vol=(RSTART>0)?substr($0,RSTART,RLENGTH):"?"}
    /^\tMonitor of Sink:/ {
      is_mon = ($4 != "n/a")
      tag = (name==def) ? " <- default" : ""
      kind = is_mon ? "[monitor]" : "[MIC]    "
      bt = (name ~ /^bluez/) ? "  (bluetooth: mic use forces the narrowband HFP codec)" : ""
      printf "  %s  vol=%-5s mute=%-3s  %s%s%s\n       %s\n", kind, vol, mute, desc, tag, bt, name
    }'
  echo
  echo "choose one with:  export CT_AUDIO_SOURCE=<name>"
  exit 0 ;;

test)
  secs="${2:-5}"
  wav="$(mktemp --suffix=.wav)"
  echo "recording ${secs}s from: $src"
  echo "  -> SPEAK NOW at your normal interview volume"
  ffmpeg -hide_banner -loglevel error -nostdin -f pulse -i "$src"          -ac 1 -ar 16000 -t "$secs" -y "$wav"
  stats="$(ffmpeg -hide_banner -nostdin -i "$wav" -af volumedetect -f null - 2>&1)"
  mean="$(sed -n 's/.*mean_volume: \(-\?[0-9.]*\) dB.*/\1/p' <<<"$stats")"
  peak="$(sed -n 's/.*max_volume: \(-\?[0-9.]*\) dB.*/\1/p' <<<"$stats")"
  echo
  echo "  mean: ${mean} dB    peak: ${peak} dB"
  awk -v m="$mean" -v p="$peak" 'BEGIN{
    if (p > -1)        print "  CLIPPING - lower the input volume";
    else if (p < -45)  print "  SILENT - wrong source, muted, or mic not connected";
    else if (m < -40)  print "  VERY QUIET - raise it:  wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 80%";
    else if (m < -30)  print "  quiet but usable - whisper will cope; louder is better";
    else               print "  GOOD - levels are fine for transcription";
  }'
  echo
  echo "  play it back:  ffplay -autoexit -nodisp $wav"
  exit 0 ;;
esac

dir="$(ct_session_dir)"
pidf="$dir/.audio.pid"

case "$1" in
start)
  [ -f "$pidf" ] && { echo "already recording (pid $(cat "$pidf"))" >&2; exit 1; }
  start_ms="$(cat "$dir/.start_ms")"
  now="$(ct_now_ms)"
  # offset of audio t=0 within the session clock; ct-transcribe adds it back
  echo $(( now - start_ms )) > "$dir/.audio_offset_ms"
  ffmpeg -hide_banner -loglevel error -nostdin \
         -f pulse -i "$src" -ac 1 -ar 16000 \
         "$dir/session.wav" & echo $! > "$pidf"
  sleep 0.4
  kill -0 "$(cat "$pidf")" 2>/dev/null || { rm -f "$pidf"; echo "ffmpeg died — check: pactl list short sources" >&2; exit 1; }
  jq --arg a session.wav '.media.audio = $a' "$dir/manifest.json" > "$dir/.m" && mv "$dir/.m" "$dir/manifest.json"
  echo "recording: $src -> $dir/session.wav"
  ;;
stop)
  [ -f "$pidf" ] || { echo "not recording" >&2; exit 1; }
  pid="$(cat "$pidf")"
  kill -INT "$pid" 2>/dev/null || true
  # ffmpeg is not a child of THIS invocation, so `wait` is a no-op here; poll
  # instead. Returning early truncates the WAV header and the file is unusable.
  for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  kill -0 "$pid" 2>/dev/null && { kill -9 "$pid" 2>/dev/null || true; sleep 0.2; }
  rm -f "$pidf"
  echo "stopped: $(du -h "$dir/session.wav" | cut -f1) $dir/session.wav"
  ;;
status)
  if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
    echo "recording (pid $(cat "$pidf")) -> $dir/session.wav"
  else
    echo "not recording"
  fi
  ;;
*) echo "usage: ct-audio {devices|test [secs]|start|stop|status}" >&2; exit 1 ;;
esac
